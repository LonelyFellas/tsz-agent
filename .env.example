TSZ_AGENT_DATABASE_URL=postgresql+psycopg://tsz_agent:change-me@127.0.0.1:5432/tsz_agent
TSZ_AGENT_API_TOKEN=replace-with-random-agent-service-token
TSZ_AGENT_TSZ_BASE_URL=http://127.0.0.1:8383
TSZ_AGENT_TSZ_SERVICE_TOKEN=replace-with-random-tsz-service-token
DEEPSEEK_API_KEY=

# Personal local ChatGPT plan access (independent of DeepSeek/OpenCode).
# First run: uv run python -m tsz_agent.auth login chatgpt
# Enabled by default; set false to disable the login entry.
# TSZ_AGENT_CHATGPT_ENABLED=false
# TSZ_AGENT_CHATGPT_AUTH_DIR=/absolute/private/path/to/chatgpt
# Local browser: local (default). Self-hosted VM: ssh; Compose defaults to ssh.
# TSZ_AGENT_CHATGPT_LOGIN_MODE=ssh

# Optional OpenCode v2.1.4 gateway; API and worker must use the same private instance.
# Requires native session_budget.js plugin; see docs/integration.md.
# TSZ_AGENT_OPENCODE_SERVER_URL=http://127.0.0.1:4096
# TSZ_AGENT_OPENCODE_SERVER_PASSWORD=<same-private-server-password-as-tsz-rust>

# Smart lexicon section agents. Enable after the supervisor database migration.
TSZ_AGENT_SUPERVISOR_ENABLED=false
# Optional Brave Search fallback when a live dictionary lookup returns no reference.
# TSZ_AGENT_DICTIONARY_SEARCH_KEY=
# Optional Collegiate API key approved for this Merriam-Webster integration.
# TSZ_AGENT_MERRIAM_WEBSTER_API_KEY=

# Optional public Youdao reference for authorized use (including local non-commercial previews).
# TSZ_AGENT_YOUDAO_PUBLIC_LOOKUP_ENABLED=false
